# Backend environment template. Copy to a local ignored file if needed.
# Never put real secrets in Git.

# Microsoft Entra (optional). Leave blank to keep the local lab and the Graph contract harness.
BOUNDARYMESH_ENTRA_TENANT_ID=
BOUNDARYMESH_ENTRA_CLIENT_ID=
BOUNDARYMESH_ENTRA_CLIENT_SECRET=
BOUNDARYMESH_ENTRA_REDIRECT_URI=http://127.0.0.1:5173/login/oauth2/code/entra
BOUNDARYMESH_FRONTEND_ORIGIN=http://127.0.0.1:5173

# HARNESS (default) or LIVE. LIVE is ignored unless Entra is fully configured and a real Graph call succeeds.
BOUNDARYMESH_GRAPH_MODE=HARNESS
